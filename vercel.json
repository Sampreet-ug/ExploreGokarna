{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/experiences.html",
      "destination": "/experiences",
      "permanent": true
    },
    {
      "source": "/gallery.html",
      "destination": "/gallery",
      "permanent": true
    },
    {
      "source": "/blogs.html",
      "destination": "/blogs",
      "permanent": true
    },
    {
      "source": "/history-of-gokarna.html",
      "destination": "/history-of-gokarna",
      "permanent": true
    },
    {
      "source": "/beaches-of-gokarna.html",
      "destination": "/beaches-of-gokarna",
      "permanent": true
    },
    {
      "source": "/best-time-to-visit-gokarna.html",
      "destination": "/best-time-to-visit-gokarna",
      "permanent": true
    },
    {
      "source": "/gokarna-in-monsoon.html",
      "destination": "/gokarna-in-monsoon",
      "permanent": true
    },
    {
      "source": "/contact.html",
      "destination": "/contact",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/experiences",
      "destination": "/experiences.html"
    },
    {
      "source": "/gallery",
      "destination": "/gallery.html"
    },
    {
      "source": "/blogs",
      "destination": "/blogs.html"
    },
    {
      "source": "/history-of-gokarna",
      "destination": "/history-of-gokarna.html"
    },
    {
      "source": "/beaches-of-gokarna",
      "destination": "/beaches-of-gokarna.html"
    },
    {
      "source": "/best-time-to-visit-gokarna",
      "destination": "/best-time-to-visit-gokarna.html"
    },
    {
      "source": "/gokarna-in-monsoon",
      "destination": "/gokarna-in-monsoon.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    }
  ],
  "headers": [
    {
      "source": "/env-config.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    }
  ]
}
